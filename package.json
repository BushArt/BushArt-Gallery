{
  "name": "bushart",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0 <25"
  },
  "description": "BushArt — Digital Sketchbook & Gallery. A minimalist, dark-themed digital art portfolio and CMS.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "eslint src/ tests/ scripts/",
    "format": "prettier --write .",
    "db:setup": "node ./node_modules/tsx/dist/cli.mjs scripts/db-setup.mjs",
    "seed:admin": "node ./node_modules/tsx/dist/cli.mjs scripts/seed-admin.ts",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:all": "node scripts/test-all.mjs",
    "test:coverage": "node ./node_modules/vitest/vitest.mjs run --coverage",
    "test:counts": "node scripts/check-test-counts.mjs",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "test:e2e": "node ./node_modules/playwright/cli.js test",
    "test:e2e:install": "node ./node_modules/playwright/cli.js install chromium"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.6.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "lucide-react": "^1.31.0",
    "mongodb": "^6.21.0",
    "next": "^16.2.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
