{
  "name": "bushart",
  "version": "0.1.0",
  "private": true,
  "description": "BushArt — Digital Sketchbook & Gallery. A minimalist, dark-themed digital art portfolio and CMS.",
  "type": "module",
  "scripts": {
    "dev": "node --use-system-ca ./node_modules/next/dist/bin/next dev",
    "build": "node --use-system-ca ./node_modules/next/dist/bin/next build",
    "start": "node --use-system-ca ./node_modules/next/dist/bin/next start",
    "lint": "eslint src/ tests/",
    "format": "prettier --write .",
    "db:setup": "node --use-system-ca scripts/db-setup.mjs",
    "seed:admin": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/seed-admin.ts",
    "test": "node --use-system-ca ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --use-system-ca ./node_modules/vitest/vitest.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.6.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "lucide-react": "^1.31.0",
    "mongodb": "^6.21.0",
    "next": "^16.2.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
